{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"custom": true,
			"customGradient": true,
			"link": true,
			"palette": [
				{ "slug": "brand", "color": "#287C70", "name": "Brand Teal" },
				{ "slug": "brand-deep", "color": "#175E52", "name": "Deep Teal" },
				{ "slug": "mint", "color": "#DDF1E9", "name": "Soft Mint" },
				{ "slug": "mint-pale", "color": "#E8F5F0", "name": "Pale Mint" },
				{ "slug": "canvas", "color": "#FAF8F2", "name": "Warm Ivory" },
				{ "slug": "surface", "color": "#FFFFFF", "name": "White Surface" },
				{ "slug": "ink", "color": "#243A34", "name": "Forest Charcoal" },
				{ "slug": "ink-2", "color": "#50645B", "name": "Secondary Text" },
				{ "slug": "border", "color": "#E3E8E1", "name": "Muted Border" },
				{ "slug": "accent", "color": "#E7A69A", "name": "Muted Coral" }
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"lineHeight": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"fontFamily": "Manrope, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"slug": "sans",
					"name": "Manrope"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.8125rem", "name": "Small" },
				{ "slug": "medium", "size": "1.0625rem", "name": "Body", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large", "size": "1.5rem", "name": "Large", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "size": "2.25rem", "name": "X-Large", "fluid": { "min": "1.6rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "size": "4.25rem", "name": "Display", "fluid": { "min": "2.5rem", "max": "4.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vw", "vh", "%" ],
			"customSpacingSize": true,
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "size": "0.5rem", "name": "2XS" },
				{ "slug": "30", "size": "1rem", "name": "XS" },
				{ "slug": "40", "size": "1.5rem", "name": "S" },
				{ "slug": "50", "size": "2rem", "name": "M" },
				{ "slug": "60", "size": "clamp(3rem, 2rem + 5vw, 4.75rem)", "name": "L" },
				{ "slug": "70", "size": "clamp(4rem, 2.5rem + 7vw, 7rem)", "name": "XL" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--canvas)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontWeight": "800", "lineHeight": "1.1" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--brand-deep)" },
				":hover": { "color": { "text": "var(--wp--preset--color--brand)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--brand)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": { "radius": "10px" },
				"typography": { "fontWeight": "700" },
				":hover": { "color": { "background": "var(--wp--preset--color--brand-deep)" } },
				":focus": { "color": { "background": "var(--wp--preset--color--brand-deep)" } }
			}
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(1rem, 0.5rem + 2vw, 3.5rem)",
				"right": "clamp(1rem, 0.5rem + 2vw, 3.5rem)"
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
