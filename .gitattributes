# Files that belong to the GitHub repository but not to the installable theme.
# `git archive` (used to build release ZIPs) leaves these out.
/.github        export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/README.md      export-ignore

# The FusionWrite AI plugin is developed here but is not part of the theme.
/fusionwrite-ai export-ignore

# Keep line endings consistent.
* text=auto eol=lf
*.png   binary
*.woff2 binary
*.pdf   binary
